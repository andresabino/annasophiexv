{
  "name": "anna-sophie-15-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "media:upload": "tsx --env-file-if-exists=.env scripts/upload.ts",
    "lifecycle": "tsx --env-file-if-exists=.env scripts/lifecycle.ts",
    "admin:provision": "tsx --env-file-if-exists=.env scripts/provision-admin.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@aws-sdk/client-s3": "^3.900.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.3.3",
    "exceljs": "^4.4.0",
    "gsap": "^3.13.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
