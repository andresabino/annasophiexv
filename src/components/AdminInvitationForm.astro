---
const {invitation={},submit='Criar convite'}=Astro.props;const names=invitation.expected_participants||[];
---
<div class="form-grid"><label><span>Nome do convite</span><input name="display_name" value={invitation.display_name||''} maxlength="120" required/></label><label><span>Tipo</span><select name="type"><option value="individual" selected={invitation.type==='individual'}>Individual</option><option value="couple" selected={invitation.type==='couple'}>Casal</option><option value="family" selected={!invitation.type||invitation.type==='family'}>Família</option><option value="group" selected={invitation.type==='group'}>Grupo</option></select></label><label><span>Telefone principal</span><input name="phone" type="tel" value={invitation.phone||''} maxlength="25"/></label><label><span>Prazo do RSVP</span><input name="rsvp_deadline" type="date" value={invitation.rsvp_deadline?new Date(invitation.rsvp_deadline).toISOString().slice(0,10):''}/></label><label><span>Pessoas previstas</span><input name="expected_guests" type="number" min="1" max="100" value={invitation.expected_guests||1} required/></label><label><span>Limite de confirmações</span><input name="max_guests" type="number" min="1" max="100" value={invitation.max_guests||1} required/></label><label><span>Rodada</span><input name="invitation_round" type="number" min="1" value={invitation.invitation_round||1} required/></label><label class="span-2"><span>Observações internas</span><textarea name="notes" rows="3" maxlength="2000">{invitation.notes||''}</textarea></label><fieldset class="span-2"><legend>Participantes previstos</legend><p>Estar previsto não significa estar confirmado.</p><div class="participants">{Array.from({length:Math.max(5,names.length)},(_,i)=><input name="participant" aria-label={`Participante previsto ${i+1}`} placeholder={`Participante ${i+1}`} value={names[i]||''}/>)}</div></fieldset></div>{invitation.updated_at&&<input type="hidden" name="updated_at" value={new Date(invitation.updated_at).toISOString()}/>}<div class="actions"><button class="btn" type="submit">{submit}</button><a class="btn secondary" href="/admin/convites">Cancelar</a></div>
