---
import Picture from './Picture.astro';
import PalazzoIntro from './PalazzoIntro.astro';
import {EVENT_START} from '../lib/lifecycle';
import '../styles/cinematic-invitation.css';
const {phase,gifts,rsvp,preview}=Astro.props;
const previewQuery=preview?'?previewPhase='+Astro.url.searchParams.get('previewPhase'):'';
---
<PalazzoIntro/>
<section id="baile" class="ballroom-scene" tabindex="-1"><Picture name="mask-detail" eager sizes="100vw" alt="Máscara veneziana dourada diante de um salão iluminado"/><div class="ballroom-shade"></div><div class="ballroom-copy" data-reveal><p class="eyebrow">AS PORTAS DO PALAZZO SE ABRIRAM</p><h1>Bem-vindo ao meu<br/><em>Baile de Máscaras.</em></h1><p>Uma noite de luz, música e histórias inesquecíveis.</p><span>ANNA SOPHIE · XV</span></div><a class="scene-scroll" href="#anna">Atravesse o salão <span>↓</span></a></section>
<section class="countdown-section"><p class="eyebrow">{phase==='EVENT_DAY'?'ESTA NOITE É NOSSA':'O BAILE SE APROXIMA...'}</p>{phase==='EVENT_DAY'?<h2>O baile começou.</h2>:<div class="countdown" data-countdown={EVENT_START} aria-label="Contagem regressiva para o baile">{['dias','horas','minutos','segundos'].map((label,i)=><div><strong data-unit={i}>—</strong><span>{label}</span></div>)}</div>}<div class="ornament" aria-hidden="true">──── ✧ ────</div></section>
<section id="anna" class="anna-story"><div class="anna-photo-preview"><Picture alt="Composição artística provisória para visualizar a futura fotografia oficial de Anna Sophie" sizes="(max-width: 767px) 100vw, 45vw"/><small>COMPOSIÇÃO ARTÍSTICA PROVISÓRIA</small></div><div class="anna-story-copy" data-reveal><p class="eyebrow">A PROTAGONISTA DESTA HISTÓRIA</p><h2>Anna<br/><em>Sophie.</em></h2><p class="script">Mais do que uma festa,<br/>um capítulo inesquecível.</p><p>Quinze anos de sonhos. Uma nova história escrita entre abraços, sorrisos e pessoas especiais.</p><a class="button outline" href={'/fotos'+previewQuery}>Ver galeria <span>↗</span></a></div></section>
<section id="local" class="venue-section cinematic-venue" data-reveal><div><p class="eyebrow">O LOCAL DO BAILE</p><h2>Estação <em>840</em></h2><p>Avenida Marechal Rondon, 840<br/>Centro — Osasco/SP</p></div><div class="venue-date"><span>06</span><div>DEZEMBRO<br/>2026 · DOMINGO</div><p>ÀS 17H30</p></div><div class="venue-actions"><a class="button gold" href="https://www.google.com/maps/search/?api=1&query=Esta%C3%A7%C3%A3o%20840%20Avenida%20Marechal%20Rondon%20840%20Osasco" target="_blank" rel="noopener noreferrer">Ver local no mapa ↗</a><a class="text-link" href="https://waze.com/ul?q=Avenida%20Marechal%20Rondon%20840%20Osasco&navigate=yes" target="_blank" rel="noopener noreferrer">Abrir no Waze ↗</a></div></section>
<section class="mask-scene"><Picture name="mask-detail" sizes="100vw" alt="Máscara veneziana dourada sobre veludo borgonha"/><div data-reveal><p class="eyebrow">PALAZZO IMPERIAL</p><h2>Baile de<br/><em>Máscaras Venezianas</em></h2><p>Elegância <i></i> Música <i></i> Amizade</p></div></section>
<section class="dress-section"><header data-reveal><p class="eyebrow">DRESS CODE</p><h2>Elegância faz parte<br/><em>da história.</em></h2><p>Trajes de gala são bem-vindos. Sua máscara faz parte dessa noite.</p></header><div class="dress-grid"><article data-reveal><div class="fashion-frame feminine"><Picture name="dress" sizes="(max-width: 767px) 45vw, 25vw" alt="Vestido de gala rosa antigo em manequim, referência de traje feminino"/></div><span>01 / TRAJE FEMININO</span><h3>Movimento & delicadeza</h3><p>Vestidos e tecidos fluidos para uma noite de gala.</p></article><article data-reveal><div class="fashion-frame masculine"><Picture name="suit" sizes="(max-width: 767px) 45vw, 25vw" alt="Smoking azul escuro em manequim, referência de traje masculino"/></div><span>02 / TRAJE MASCULINO</span><h3>Clássico & atemporal</h3><p>Alfaiataria, camisa e detalhes que fazem a diferença.</p></article><article data-reveal><div class="fashion-frame"><Picture name="mask-detail" sizes="(max-width: 767px) 45vw, 25vw" alt="Máscara veneziana com detalhes dourados"/></div><span>03 / MÁSCARAS</span><h3>Um toque de mistério</h3><p>Escolha a máscara que melhor conta a sua história.</p></article><article data-reveal><div class="fashion-frame accessories" aria-hidden="true"><svg viewBox="0 0 180 220"><ellipse cx="90" cy="98" rx="48" ry="54" fill="none" stroke="currentColor" stroke-width="5" stroke-dasharray="1 8" stroke-linecap="round"/><path d="M90 150L80 165L90 183L100 165Z" fill="currentColor"/><path d="M38 45L30 60L38 74L46 60ZM142 45L134 60L142 74L150 60Z" fill="currentColor"/></svg></div><span>04 / ACESSÓRIOS</span><h3>Pequenos encantos</h3><p>Brilhos sutis e acessórios para completar o seu traje.</p></article></div></section>
{(rsvp||gifts)&&<section class="closing-actions cinematic-actions">{rsvp&&<article data-reveal><p class="eyebrow">SEU LUGAR NO BAILE</p><h2>Confirme<br/><em>sua presença.</em></h2><p>A confirmação é feita pelo link pessoal recebido no seu convite. Um carinho reservado a você e aos seus convidados.</p><a class="button gold" href="#convite-pessoal">Confirmar presença ↗</a><details id="convite-pessoal"><summary>Como acessar meu convite?</summary><p>Abra o link pessoal enviado pela família. Caso não o encontre, solicite novamente a quem enviou seu convite.</p></details></article>}{gifts&&<article data-reveal><p class="eyebrow">LISTA DE PRESENTES</p><h2>O maior presente<br/><em>é ter você.</em></h2><p>Sua presença é o nosso maior presente. Para quem desejar, reunimos algumas ideias com o jeitinho da Anna Sophie.</p><a class="button outline" href={'/presentes'+previewQuery}>Ver presentes ↗</a></article>}</section>}
<section class="venice-end"><Picture name="venice-night" sizes="100vw" alt="Veneza à noite, com luzes refletidas no canal"/><div data-reveal><p class="eyebrow">OBRIGADA POR FAZER PARTE DESSA HISTÓRIA</p><h2>Nos vemos<br/><em>no baile.</em></h2><p>ANNA SOPHIE · XV</p></div></section>
<script>
const counter=document.querySelector<HTMLElement>('[data-countdown]');
if(counter){const tick=()=>{const left=Date.parse(counter.dataset.countdown!)-Date.now();if(left<=0){counter.innerHTML='<h2>O baile começou.</h2>';return false}const values=[Math.floor(left/86400000),Math.floor(left/3600000)%24,Math.floor(left/60000)%60,Math.floor(left/1000)%60];counter.querySelectorAll('[data-unit]').forEach((el,i)=>el.textContent=String(values[i]).padStart(2,'0'));return true};if(tick()){const timer=setInterval(()=>{if(!tick())clearInterval(timer)},1000)}}
document.querySelectorAll('a[href="#convite-pessoal"]').forEach(link=>link.addEventListener('click',()=>{document.querySelector<HTMLDetailsElement>('#convite-pessoal')!.open=true}));
</script>
