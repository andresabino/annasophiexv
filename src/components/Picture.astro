---
interface Props { name?:string; base?:string; mobileBase?:string; alt:string; eager?:boolean; class?:string; sizes?:string; width?:number; height?:number; mobileWidth?:number; mobileHeight?:number; }
const {name,base:customBase,mobileBase,alt,eager=false,class:className='',sizes='(max-width: 767px) 100vw, 50vw',width=1440,height=960,mobileWidth=960,mobileHeight=1440}=Astro.props;
const base=customBase??'/images/'+name;
const widths=[640,960,1440];
const srcset=(source:string,format:'webp'|'avif')=>widths.map(w=>`${source}-${w}.${format} ${w}w`).join(', ');
---
<picture>
 {mobileBase&&<source media="(max-width: 767px)" type="image/avif" srcset={srcset(mobileBase,'avif')} sizes="100vw" width={mobileWidth} height={mobileHeight}/>}
 {mobileBase&&<source media="(max-width: 767px)" type="image/webp" srcset={srcset(mobileBase,'webp')} sizes="100vw" width={mobileWidth} height={mobileHeight}/>}
 {customBase&&<source type="image/avif" srcset={srcset(base,'avif')} sizes={eager?'100vw':sizes}/>}
 <source type="image/webp" srcset={srcset(base,'webp')} sizes={eager?'100vw':sizes}/>
 <img class={className} src={base+'-1440.webp'} srcset={srcset(base,'webp')} sizes={eager?'100vw':sizes} width={width} height={height} alt={alt} loading={eager?'eager':'lazy'} fetchpriority={eager?'high':'auto'} decoding="async" />
</picture>
