---
import '../styles/admin.css';import '../styles/admin-age.css';const {title='Admin',user=(Astro.locals as any).admin}=Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>{title} · Anna Sophie XV</title></head><body><header class="admin-top"><a href="/admin" class="admin-brand"><b>AS</b><span>Anna Sophie XV<small>Administração</small></span></a>{user&&<><nav><a href="/admin">Dashboard</a><a href="/admin/convites">Convites</a><a href="/admin/importar">Importar</a><a href="/admin/auditoria">Auditoria</a>{user.role==='ADMIN'&&<a href="/admin/usuarios">Usuários</a>}</nav><div class="admin-user"><span>{user.name}<small>{user.role}</small></span><form action="/admin/logout" method="post"><button>Sair</button></form></div></>}</header><main class="admin-main"><slot/></main><div id="admin-toast" role="status" aria-live="polite"></div><script>document.querySelectorAll<HTMLElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{await navigator.clipboard.writeText(button.dataset.copy||'');const toast=document.querySelector<HTMLElement>('#admin-toast')!;toast.textContent='Link do convite copiado.';toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2500)}));</script></body></html>
