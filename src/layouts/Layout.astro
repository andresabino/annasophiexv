---
import '../styles/global.css';
import type {Phase} from '../lib/lifecycle';
import {siteUrl} from '../lib/config';
import {annaMedia} from '../lib/media';
interface Props{title?:string;phase?:Phase;privatePage?:boolean;preview?:boolean;gifts?:boolean;hero?:boolean;rsvp?:boolean;pix?:boolean;cinematic?:boolean}
const {title='Anna Sophie — XV Anos',phase='SAVE_THE_DATE',privatePage=false,preview=false,gifts=false,hero=false,rsvp=false,pix=false,cinematic=false}=Astro.props;
const full=phase==='INVITATION'||phase==='EVENT_DAY';
const path=privatePage?'/':Astro.url.pathname;
const canonical=siteUrl()+path;
const previewValue=preview?Astro.url.searchParams.get('previewPhase'):null;
const link=(path:string)=>path+(previewValue?'?previewPhase='+encodeURIComponent(previewValue):'');
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content="Uma noite, um baile, uma nova história. Anna Sophie celebra seus XV anos em 06 de dezembro de 2026, às 17h30, na Estação 840, Osasco."/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content={cinematic?'#07101d':'#6B1E2A'}/><meta name="robots" content={privatePage||preview?'noindex, nofollow':'index, follow'}/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content="Reserve esta noite. 06 • 12 • 2026 — 17h30 — Estação 840, Osasco."/><meta property="og:url" content={canonical}/><meta property="og:image" content={siteUrl()+'/images/og.jpg'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:image" content={siteUrl()+'/images/og.jpg'}/>{hero&&<link rel="preload" as="image" href={cinematic?'/images/mask-detail-1440.webp':annaMedia.base+"-1440.webp"} imagesrcset={cinematic?undefined:[640,960,1440].map(w=>annaMedia.base+"-"+w+".webp "+w+"w").join(", ")} imagesizes="100vw"/>}</head><body class:list={[cinematic&&'cinematic-page']} data-state={JSON.stringify({phase,gifts,rsvp,pix})} data-preview={String(preview)}>
<a class="skip" href="#main">Pular para o conteúdo</a>
<header class:list={['site-header',cinematic&&'cinematic-header']}><a class="monogram" href={link('/')} aria-label="Anna Sophie, início">A<span>S</span><small>XV</small></a><a class="header-title" href={link('/')}>ANNA SOPHIE <span>XV ANOS</span></a>{!cinematic&&<nav aria-label="Navegação principal">{full&&<><a href={link('/')+'#baile'}>O baile</a><a href={link('/')+'#anna'}>Anna Sophie</a><a href={link('/')+'#local'}>O local</a></>}{phase==='SAVE_THE_DATE'?<a href={link('/save-the-date')}>Reserve a data</a>:<a href={link('/fotos')}>Memórias</a>}{gifts&&<a href={link('/presentes')}>Presentes</a>}</nav>}<button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu <span>☰</span></button></header>
<nav id="mobile-nav" class:list={[cinematic&&'cinematic-menu']} aria-label="Navegação mobile" hidden><a href={link('/')}>Início</a>{cinematic?<>{rsvp&&<a href="#convite-pessoal">Confirmar presença</a>}<a href="#local">Local do evento</a>{gifts&&<a href={link('/presentes')}>Lista de presentes</a>}<a href={link('/fotos')}>Galeria</a></>:<>{full&&<><a href={link('/')+'#baile'}>O baile</a><a href={link('/')+'#local'}>Local e horário</a></>}{phase==='SAVE_THE_DATE'?<a href={link('/save-the-date')}>Reserve a data</a>:<a href={link('/fotos')}>Memórias</a>}{gifts&&<a href={link('/presentes')}>Presentes</a>}</>}</nav>
{preview&&<aside class="preview-label">Preview local · {phase.toLowerCase().replaceAll('_',' ')}</aside>}
<main id="main"><slot/></main><footer class="footer"><a href={link('/')} class="footer-brand">Anna Sophie <span>XV</span></a><p>06 DE DEZEMBRO DE 2026 · OSASCO</p><small>Com carinho, Anna Sophie e família.</small></footer>
<div class="toast" role="status" aria-live="polite"></div>
<script>

const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector<HTMLElement>('#mobile-nav')!.hidden=!open});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector<HTMLElement>('#mobile-nav')!.hidden=true;menu?.setAttribute('aria-expanded','false')}});
document.querySelectorAll('#mobile-nav a').forEach(a=>a.addEventListener('click',()=>{document.querySelector<HTMLElement>('#mobile-nav')!.hidden=true;menu?.setAttribute('aria-expanded','false')}));
if(!matchMedia('(prefers-reduced-motion: reduce)').matches && document.querySelector('[data-reveal], [data-parallax]')){
const {gsap}=await import('gsap');
const {ScrollTrigger}=await import('gsap/ScrollTrigger');
gsap.registerPlugin(ScrollTrigger);
const mm=gsap.matchMedia();
mm.add('(prefers-reduced-motion: no-preference)',()=>{
 gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach(el=>gsap.from(el,{y:24,opacity:0,duration:1.1,ease:'power2.out',scrollTrigger:{trigger:el,start:'top 94%',once:true}}));
 gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach(el=>gsap.fromTo(el,{yPercent:-3},{yPercent:3,ease:'none',scrollTrigger:{trigger:el.parentElement,start:'top bottom',end:'bottom top',scrub:1.5}}));
});
}
if(document.body.dataset.preview!=='true'){setInterval(async()=>{if(document.hidden)return;try{const response=await fetch('/api/state');if(!response.ok)return;const state=await response.json();if(JSON.stringify(state)!==document.body.dataset.state)location.reload()}catch{}},60000)}
const toast=(message:string)=>{const el=document.querySelector<HTMLElement>('.toast')!;el.textContent=message;el.classList.add('show');window.setTimeout(()=>el.classList.remove('show'),3500)};
document.querySelectorAll<HTMLElement>('[data-copy]').forEach(el=>el.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(el.dataset.copy||'');toast(el.dataset.message||'Link copiado.')}catch{toast('Não foi possível copiar. Selecione e copie o endereço.')}}));
document.querySelector('[data-share]')?.addEventListener('click',async()=>{try{if(navigator.share)await navigator.share({title:'Anna Sophie — XV Anos',text:'Reserve esta noite: 06/12/2026, às 17h30.',url:document.querySelector('[data-copy]')?.getAttribute('data-copy')||location.href});else{await navigator.clipboard.writeText(location.href);toast('Link copiado.')}}catch{}});
</script></body></html>
