---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminInvitationForm from '../../../../components/AdminInvitationForm.astro';
import {assertCsrf} from '../../../../lib/admin/auth';
import {getInvitation,updateInvitation,AdminError} from '../../../../lib/admin/invitations';
const user=(Astro.locals as any).admin,csrf=(Astro.locals as any).csrf,sessionToken=(Astro.locals as any).sessionToken,id=Number(Astro.params.id);
let error='',item=await getInvitation(id);if(!item)return Astro.redirect('/admin/convites',303);
if(Astro.request.method==='POST')try{
 const form=await Astro.request.formData();assertCsrf(form,sessionToken);await updateInvitation(id,form,user.id);return Astro.redirect(`/admin/convites/${id}`,303);
}catch(e){if(e instanceof Response)throw e;error=e instanceof AdminError?e.message:'Não foi possível salvar.';item=await getInvitation(id);}
---
<AdminLayout title={`Editar ${item.display_name}`}><header class="page-head"><div><p class="eyebrow">CONVITES</p><h1>Editar convite</h1></div></header>{error&&<p class="notice error">{error}</p>}<form class="panel" method="post"><AdminInvitationForm invitation={item} submit="Salvar alterações" csrf={csrf}/></form></AdminLayout>
