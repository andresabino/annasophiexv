---
import AdminLayout from '../../../../layouts/AdminLayout.astro';import AdminInvitationForm from '../../../../components/AdminInvitationForm.astro';import {getInvitation,updateInvitation,AdminError} from '../../../../lib/admin/invitations';const user=(Astro.locals as any).admin;const id=Number(Astro.params.id);let error='';let item=await getInvitation(id);if(!item)return Astro.redirect('/admin/convites',303);if(Astro.request.method==='POST'){try{await updateInvitation(id,await Astro.request.formData(),user.id);return Astro.redirect(`/admin/convites/${id}`,303)}catch(e){error=e instanceof AdminError?e.message:'Não foi possível salvar.';item=await getInvitation(id)}}
---
<AdminLayout title={`Editar ${item.display_name}`}><header class="page-head"><div><p class="eyebrow">CONVITES</p><h1>Editar convite</h1></div></header>{error&&<p class="notice error">{error}</p>}<form class="panel" method="post"><AdminInvitationForm invitation={item} submit="Salvar alterações"/></form></AdminLayout>
