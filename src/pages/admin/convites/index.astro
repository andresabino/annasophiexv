---
import AdminLayout from '../../../layouts/AdminLayout.astro';import {listInvitations} from '../../../lib/admin/invitations';const q=Astro.url.searchParams.get('q')||'';const filter=Astro.url.searchParams.get('filter')||'';const round=Astro.url.searchParams.get('round')||'';const items=await listInvitations(q,filter,round);const label=(i:any)=>i.revoked_at?'Revogado':i.rsvp_status==='confirmed'?'Confirmado':i.rsvp_status==='declined'?'Não irá':i.rsvp_deadline&&new Date(i.rsvp_deadline)<new Date()?'Prazo vencido':i.delivered_at?'Entregue':'Não entregue';
---
<AdminLayout title="Convites"><header class="page-head"><div><p class="eyebrow">GESTÃO</p><h1>Convites</h1></div><div class="actions"><a class="btn secondary" href="/admin/exportar.csv">CSV</a><a class="btn secondary" href="/admin/exportar.xlsx">XLSX</a><a class="btn" href="/admin/convites/novo">Novo convite</a></div></header><form class="toolbar"><input name="q" value={q} placeholder="Buscar convite, participante ou telefone"/><select name="filter"><option value="">Todos</option>{Object.entries({not_delivered:'Não entregues',delivered:'Entregues',viewed:'Visualizados',pending:'Aguardando resposta',confirmed:'Confirmados',declined:'Não irão',overdue:'Prazo vencido',revoked:'Revogados'}).map(([v,l])=><option value={v} selected={filter===v}>{l}</option>)}</select><input style="max-width:110px" name="round" type="number" min="1" value={round} placeholder="Rodada"/><button class="btn" type="submit">Filtrar</button></form><div class="table-wrap"><table><thead><tr><th>Convite</th><th>Rodada</th><th>Tipo</th><th>Previstos</th><th>Limite</th><th>Confirmados</th><th>Prazo</th><th>Status</th><th>Ações</th></tr></thead><tbody>{items.map(i=><tr><td data-label="Convite"><b>{i.display_name}</b><br/><small>{i.phone}</small></td><td data-label="Rodada">{i.invitation_round}ª</td><td data-label="Tipo">{i.type}</td><td data-label="Previstos">{i.expected_guests}</td><td data-label="Limite">{i.max_guests}</td><td data-label="Confirmados">{i.confirmed_guests}</td><td data-label="Prazo">{i.rsvp_deadline?new Intl.DateTimeFormat('pt-BR').format(new Date(i.rsvp_deadline)):'—'}</td><td data-label="Status"><span class:list={['badge',i.revoked_at?'danger':i.rsvp_status==='confirmed'?'ok':'warn']}>{label(i)}</span></td><td data-label="Ações"><a class="btn small secondary" href={`/admin/convites/${i.id}`}>Abrir</a></td></tr>)}</tbody></table>{!items.length&&<p class="empty">Nenhum convite encontrado.</p>}</div></AdminLayout>
