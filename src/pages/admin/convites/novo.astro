---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminInvitationForm from '../../../components/AdminInvitationForm.astro';
import {assertCsrf} from '../../../lib/admin/auth';
import {createInvitation,AdminError} from '../../../lib/admin/invitations';
const user=(Astro.locals as any).admin,csrf=(Astro.locals as any).csrf,sessionToken=(Astro.locals as any).sessionToken;
let error='';
if(Astro.request.method==='POST')try{
 const form=await Astro.request.formData();assertCsrf(form,sessionToken);
 const id=await createInvitation(form,user.id);return Astro.redirect(`/admin/convites/${id}?created=1`,303);
}catch(e){if(e instanceof Response)throw e;error=e instanceof AdminError?e.message:'Não foi possível criar o convite.';}
---
<AdminLayout title="Novo convite"><header class="page-head"><div><p class="eyebrow">CONVITES</p><h1>Novo convite</h1></div></header>{error&&<p class="notice error">{error}</p>}<form class="panel" method="post"><AdminInvitationForm csrf={csrf}/></form></AdminLayout>
