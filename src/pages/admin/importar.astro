---
import AdminLayout from '../../layouts/AdminLayout.astro';import {parseImport,validateDuplicates,importRows,type ImportRow} from '../../lib/admin/import-export';import {capacitySummary} from '../../lib/admin/capacity';const user=(Astro.locals as any).admin;let rows:ImportRow[]=[],message='',error='';let capacity=await capacitySummary();if(Astro.request.method==='POST'){const form=await Astro.request.formData();try{if(form.get('mode')==='confirm'){rows=JSON.parse(String(form.get('payload')||'[]'));await importRows(rows,user.id);message=`${rows.length} convites importados.`;rows=[];}else{const file=form.get('file');if(!(file instanceof File)||!file.size)throw new Error('Selecione um arquivo CSV ou XLSX.');if(file.size>2_000_000)throw new Error('O arquivo deve ter no máximo 2 MB.');rows=await validateDuplicates(await parseImport(await file.arrayBuffer(),file.name));}capacity=await capacitySummary();}catch(e){error=e instanceof Error?e.message:'Não foi possível processar o arquivo.';}}const valid=rows.filter(r=>!r.errors.length);const impact=valid.reduce((sum,r)=>sum+r.max_guests,0);
---
<AdminLayout title="Importar convites"><header class="page-head"><div><p class="eyebrow">CSV OU XLSX</p><h1>Importar convites</h1></div><a class="btn secondary" href="/admin/modelo-importacao.xlsx">Baixar modelo</a></header>{message&&<p class="notice">{message}</p>}{error&&<p class="notice error">{error}</p>}<section class="panel"><form method="post" enctype="multipart/form-data"><input type="hidden" name="mode" value="preview"/><label>Arquivo<input type="file" name="file" accept=".csv,.xlsx" required/></label><button class="btn" type="submit">Validar arquivo</button></form></section>{rows.length>0&&<section class="panel" style="margin-top:20px"><h2>Prévia</h2><p>{rows.length} registros encontrados · {valid.length} válidos · {rows.length-valid.length} com problemas.</p><p class="notice">Planejamento atual: {capacity.planned} pessoas. A importação adicionará até {impact}, totalizando {capacity.planned+impact}. O mínimo contratado de {capacity.contractedMinimum} é apenas uma referência e não bloqueia a importação.</p><div class="table-wrap"><table><thead><tr><th>Linha</th><th>Convite</th><th>Limite</th><th>Rodada</th><th>Problemas</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.line}</td><td>{r.display_name}</td><td>{r.max_guests}</td><td>{r.invitation_round}</td><td>{r.errors.join(', ')||'—'}</td></tr>)}</tbody></table></div>{valid.length===rows.length&&<form method="post"><input type="hidden" name="mode" value="confirm"/><input type="hidden" name="payload" value={JSON.stringify(rows)}/><button class="btn" type="submit">Confirmar importação</button></form>}</section>}</AdminLayout>
