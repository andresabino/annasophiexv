---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {database,EVENT_SLUG} from '../../lib/db';
import {capacitySummary} from '../../lib/admin/capacity';
const capacity=await capacitySummary();
const {rows:[counts]}=await database().query(`SELECT count(*)::int total,count(*) FILTER(WHERE delivered_at IS NULL AND revoked_at IS NULL)::int not_delivered,count(*) FILTER(WHERE delivered_at IS NOT NULL)::int delivered,count(*) FILTER(WHERE first_viewed_at IS NOT NULL)::int viewed,count(*) FILTER(WHERE r.id IS NULL AND i.revoked_at IS NULL)::int pending,count(*) FILTER(WHERE r.status='confirmed')::int confirmed,count(*) FILTER(WHERE r.status IN ('declined','cancelled'))::int declined,count(*) FILTER(WHERE r.id IS NULL AND i.rsvp_deadline<now() AND i.revoked_at IS NULL)::int overdue,count(*) FILTER(WHERE i.revoked_at IS NOT NULL)::int revoked FROM invitations i JOIN events e ON e.id=i.event_id LEFT JOIN rsvps r ON r.invitation_id=i.id WHERE e.slug=$1`,[EVENT_SLUG]);
const isOverdue=(value:any)=>new Date(value).getTime()<Date.now();
const {rows:attention}=await database().query(`SELECT i.id,i.display_name,i.max_guests,i.rsvp_deadline FROM invitations i JOIN events e ON e.id=i.event_id LEFT JOIN rsvps r ON r.invitation_id=i.id WHERE e.slug=$1 AND r.id IS NULL AND i.revoked_at IS NULL AND i.rsvp_deadline IS NOT NULL AND i.rsvp_deadline<now()+interval '3 days' ORDER BY i.rsvp_deadline LIMIT 12`,[EVENT_SLUG]);
const {rows:rounds}=await database().query(`SELECT i.invitation_round round,sum(i.max_guests)::int offered,COALESCE(sum(r.confirmed_guests) FILTER(WHERE r.status='confirmed'),0)::int confirmed,COALESCE(sum(i.max_guests) FILTER(WHERE r.status IN ('declined','cancelled')),0)::int declined,COALESCE(sum(i.max_guests) FILTER(WHERE r.id IS NULL AND i.revoked_at IS NULL),0)::int pending,COALESCE(sum(i.max_guests) FILTER(WHERE i.revoked_at IS NOT NULL),0)::int released FROM invitations i JOIN events e ON e.id=i.event_id LEFT JOIN rsvps r ON r.invitation_id=i.id WHERE e.slug=$1 GROUP BY i.invitation_round ORDER BY i.invitation_round`,[EVENT_SLUG]);
const number=(value:number)=>new Intl.NumberFormat('pt-BR',{maximumFractionDigits:1}).format(value);
---
<AdminLayout title="Dashboard">
 <header class="page-head"><div><p class="eyebrow">DOMINGO · 06 DE DEZEMBRO · 17H30</p><h1>Visão geral</h1></div><a class="btn" href="/admin/convites/novo">Novo convite</a></header>
 <section class="metrics"><article class="metric"><strong>{capacity.confirmed}</strong><span>Pessoas confirmadas</span></article><article class="metric"><strong>{capacity.committed}</strong><span>Limites pendentes</span></article><article class="metric"><strong>{capacity.planned}</strong><span>Total planejado</span></article><article class="metric"><strong>{capacity.contractedMinimum}</strong><span>Mínimo contratado</span></article></section>
 <section class="panel billing-panel" style="margin-bottom:20px"><h2>Estimativa de cobrança</h2><div class="capacity-bar"><span style={`width:${Math.min(100,capacity.billableEquivalent/capacity.contractedMinimum*100)}%`}></span></div><p><strong>{number(capacity.billableEquivalent)} equivalentes pagantes</strong> para um mínimo contratado de {capacity.contractedMinimum}.</p>{capacity.excessEquivalent>0?<p class="notice"><strong>{number(capacity.excessEquivalent)} equivalentes excedentes.</strong> Esta informação é apenas uma estimativa e não impede novos cadastros ou confirmações.</p>:capacity.remainingToMinimum===0?<p class="notice"><strong>Referência de {capacity.contractedMinimum} pessoas atingida.</strong> Novos cadastros e confirmações continuam permitidos.</p>:<p>Ainda faltam {number(capacity.remainingToMinimum)} equivalentes para atingir o mínimo contratado. Não existe bloqueio ao ultrapassá-lo.</p>}<small>Cálculo informativo: 13 anos ou mais = valor integral; 8 a 12 anos = meio valor; 0 a 7 anos = isento.</small></section>
 <section class="metrics age-metrics"><article class="metric"><strong>{capacity.adults}</strong><span>Valor integral · 13+</span></article><article class="metric"><strong>{capacity.age_8_12}</strong><span>Meio valor · 8 a 12</span></article><article class="metric"><strong>{capacity.age_0_7}</strong><span>Isentos · 0 a 7</span></article><article class="metric"><strong>{number(capacity.billableEquivalent)}</strong><span>Equivalentes pagantes</span></article></section>
 <div class="grid-2"><section class="panel"><h2>Convites</h2><div class="metrics"><div><b>{counts.total}</b><small>Total</small></div><div><b>{counts.not_delivered}</b><small>Não entregues</small></div><div><b>{counts.delivered}</b><small>Entregues</small></div><div><b>{counts.viewed}</b><small>Visualizados</small></div><div><b>{counts.pending}</b><small>Aguardando</small></div><div><b>{counts.confirmed}</b><small>Confirmados</small></div><div><b>{counts.declined}</b><small>Não irão</small></div><div><b>{counts.revoked}</b><small>Revogados</small></div></div><h2 style="margin-top:25px">Rodadas</h2><div class="rounds">{rounds.map(r=><article class="round"><strong>{r.round}ª rodada</strong><p>{r.offered} ofertadas<br/>{r.confirmed} confirmados<br/>{r.pending} pendentes<br/>{r.released} liberadas</p></article>)}</div></section><section class="panel"><h2>Atenção necessária</h2><div class="attention">{attention.length?attention.map(item=><a class={isOverdue(item.rsvp_deadline)?'overdue':''} href={`/admin/convites/${item.id}`}><span><b>{item.display_name}</b><br/>{item.max_guests} vagas</span><small>{isOverdue(item.rsvp_deadline)?'Prazo vencido':new Intl.DateTimeFormat('pt-BR',{dateStyle:'short'}).format(new Date(item.rsvp_deadline))}</small></a>):<p class="empty">Nenhum prazo exige atenção.</p>}</div></section></div>
</AdminLayout>
