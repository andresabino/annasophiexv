---
import '../../styles/admin.css';import {database} from '../../lib/db';import {verifyPassword,createSession,SESSION_COOKIE,cookieOptions} from '../../lib/admin/auth';let error='';if(Astro.request.method==='POST'){try{const form=await Astro.request.formData();const email=String(form.get('email')||'').trim().toLowerCase();const password=String(form.get('password')||'');const {rows}=await database().query('SELECT id,password_hash,active FROM admin_users WHERE email=$1',[email]);const user=rows[0];if(!user||!user.active||!await verifyPassword(password,user.password_hash))throw new Error('Credenciais inválidas.');const token=await createSession(user.id);await database().query('UPDATE admin_users SET last_login_at=now() WHERE id=$1',[user.id]);Astro.cookies.set(SESSION_COOKIE,token,cookieOptions(import.meta.env.PROD));const next=String(Astro.url.searchParams.get('next')||'/admin');return Astro.redirect(next.startsWith('/admin')?next:'/admin',303);}catch(e){error=e instanceof Error&&e.message==='Credenciais inválidas.'?e.message:'Não foi possível entrar agora.';}}
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Entrar · Admin Anna Sophie</title></head><body class="login-page"><main class="login-card"><p class="eyebrow">ANNA SOPHIE XV</p><h1>Administração</h1><p>Acesso reservado à família e à assessoria.</p>{error&&<p class="notice error" role="alert">{error}</p>}<form method="post"><label>E-mail<input name="email" type="email" autocomplete="username" required/></label><label>Senha<input name="password" type="password" autocomplete="current-password" required/></label><button class="btn" type="submit">Entrar</button></form></main></body></html>
