---
import AdminLayout from '../../layouts/AdminLayout.astro';
import {database} from '../../lib/db';
import {assertCsrf,requireRole,hashPassword} from '../../lib/admin/auth';
import {audit} from '../../lib/admin/audit';
const current=(Astro.locals as any).admin,csrf=(Astro.locals as any).csrf,sessionToken=(Astro.locals as any).sessionToken;
requireRole(current,'ADMIN');let message='',error='';
if(Astro.request.method==='POST'){
 const form=await Astro.request.formData();
 try{
  assertCsrf(form,sessionToken);const action=String(form.get('action'));
  if(action==='create'){
   const name=String(form.get('name')||'').trim(),email=String(form.get('email')||'').trim().toLowerCase(),role=String(form.get('role')),password=String(form.get('password')||'');
   if(!name||!email||!['ADMIN','EDITOR'].includes(role))throw new Error('Revise os dados.');
   const passwordHash=await hashPassword(password),client=await database().connect();
   try{
    await client.query('BEGIN');
    const row=(await client.query('INSERT INTO admin_users(name,email,password_hash,role) VALUES($1,$2,$3,$4) RETURNING id,name,email,role,active',[name,email,passwordHash,role])).rows[0];
    await client.query('INSERT INTO admin_user_events(admin_user_id,event_id) VALUES($1,$2)',[row.id,current.eventId]);
    await audit(client,current.id,'UPDATE_ADMIN_USER','admin_user',row.id,null,row);await client.query('COMMIT');
   }catch(e){await client.query('ROLLBACK');throw e}finally{client.release()}
   message='Usuário provisionado.';
  }else{
   const id=Number(form.get('id'));if(id===current.id)throw new Error('Altere seu próprio acesso somente em uma sessão administrativa separada.');
   const role=String(form.get('role')),active=form.get('active')==='true',client=await database().connect();
   try{
    await client.query('BEGIN');const before=(await client.query('SELECT u.id,u.name,u.email,u.role,u.active FROM admin_users u JOIN admin_user_events aue ON aue.admin_user_id=u.id WHERE u.id=$1 AND aue.event_id=$2 FOR UPDATE',[id,current.eventId])).rows[0];
    if(!before)throw new Error('Usuário não encontrado neste evento.');
    const after=(await client.query('UPDATE admin_users SET role=$2,active=$3,updated_at=now() WHERE id=$1 RETURNING id,name,email,role,active',[id,role,active])).rows[0];
    await audit(client,current.id,'UPDATE_ADMIN_USER','admin_user',id,before,after);await client.query('COMMIT');
   }catch(e){await client.query('ROLLBACK');throw e}finally{client.release()}
   message='Usuário atualizado.';
  }
 }catch(e){if(e instanceof Response)throw e;error=e instanceof Error?e.message:'Não foi possível atualizar.';}
}
const {rows:users}=await database().query(`SELECT u.id,u.name,u.email,u.role,u.active,u.last_login_at,u.created_at FROM admin_users u JOIN admin_user_events aue ON aue.admin_user_id=u.id WHERE aue.event_id=$1 ORDER BY u.name`,[current.eventId]);
---
<AdminLayout title="Usuários">
 <header class="page-head"><div><p class="eyebrow">ACESSO PRIVADO</p><h1>Usuários</h1></div></header>{message&&<p class="notice">{message}</p>}{error&&<p class="notice error">{error}</p>}
 <section class="panel"><h2>Provisionar usuário</h2><p>Não há cadastro público. Informe os e-mails reais de André, Adriana, Anna ou Assessoria.</p><form method="post" class="form-grid"><input type="hidden" name="_csrf" value={csrf}/><input type="hidden" name="action" value="create"/><label><span>Nome</span><input name="name" required/></label><label><span>E-mail</span><input name="email" type="email" required/></label><label><span>Perfil</span><select name="role"><option>EDITOR</option><option>ADMIN</option></select></label><label><span>Senha inicial (mínimo 12 caracteres)</span><input name="password" type="password" minlength="12" required/></label><button class="btn" type="submit">Provisionar</button></form></section>
 <div class="table-wrap" style="margin-top:20px"><table><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Ativo</th><th>Último login</th><th>Ação</th></tr></thead><tbody>{users.map(u=><tr><td data-label="Nome">{u.name}</td><td data-label="E-mail">{u.email}</td><td data-label="Perfil">{u.role}</td><td data-label="Ativo">{u.active?'Sim':'Não'}</td><td data-label="Último login">{u.last_login_at?new Intl.DateTimeFormat('pt-BR').format(new Date(u.last_login_at)):'—'}</td><td data-label="Ação">{u.id!==current.id&&<form method="post" class="actions"><input type="hidden" name="_csrf" value={csrf}/><input type="hidden" name="action" value="update"/><input type="hidden" name="id" value={u.id}/><select name="role"><option selected={u.role==='EDITOR'}>EDITOR</option><option selected={u.role==='ADMIN'}>ADMIN</option></select><select name="active"><option value="true" selected={u.active}>Ativo</option><option value="false" selected={!u.active}>Inativo</option></select><button class="btn small">Salvar</button></form>}</td></tr>)}</tbody></table></div>
</AdminLayout>
