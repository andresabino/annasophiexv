---
import Layout from '../layouts/Layout.astro';
import {siteState} from '../lib/config';
import {getPhotos} from '../lib/photos';
import {officialEssayFiles} from '../lib/media';
const state=await siteState(Astro.url);
const photos=await getPhotos();
const post=state.phase==='POST_EVENT';
const officialPhotos=officialEssayFiles.map((file,index)=>({image_url:`/images/anna/final/ensaio/${file}`,thumbnail_url:`/images/anna/final/gallery/${file.replace('.jpg','-640.webp')}`,title:`Anna Sophie · Ensaio XV · ${String(index+1).padStart(2,'0')}`,album:'Ensaio XV',slug:'ensaio-xv'}));
const galleryPhotos=photos.length?photos:officialPhotos;
const categories=[...new Map(galleryPhotos.map(p=>[p.slug,p.album])).entries()];
---
<Layout {...state} title="Memórias — Anna Sophie XV"><section class="page-intro"><p class="eyebrow">O ÁLBUM DA NOSSA HISTÓRIA</p><h1>{post?'Uma noite':'Momentos antes'}<br/><em>{post?'para sempre.':'do baile.'}</em></h1><p>{post?'Cada imagem, um pedacinho desse sonho.':'Um olhar sobre os sonhos que antecedem a nossa grande noite.'}</p></section>
<div class="category-nav" role="group" aria-label="Filtrar álbum"><button data-filter="all" aria-pressed="true">Todos</button>{categories.map(([slug,name])=><button data-filter={slug} aria-pressed="false">{name}</button>)}</div><div class="gallery">{galleryPhotos.map(p=><figure data-album={p.slug}><button data-photo={p.image_url} data-title={p.title||p.album} aria-label={'Ampliar '+(p.title||p.album)}><img src={p.thumbnail_url||p.image_url} alt={p.title||p.album} loading="lazy" width="600" height="600"/></button><figcaption>{p.title||p.album}</figcaption></figure>)}</div>
<dialog class="lightbox" aria-label="Foto ampliada"><img alt="" width="1000" height="800"/><p></p><button class="close-dialog">Fechar</button></dialog></Layout>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-album]').forEach(figure=>figure.hidden=button.dataset.filter!=='all'&&button.dataset.filter!==figure.dataset.album)}));
const dialog=document.querySelector<HTMLDialogElement>('.lightbox')!;
document.querySelectorAll<HTMLElement>('[data-photo]').forEach(button=>button.addEventListener('click',()=>{const img=dialog.querySelector('img')!;img.src=button.dataset.photo!;img.alt=button.dataset.title!;dialog.querySelector('p')!.textContent=button.dataset.title!;dialog.showModal()}));
dialog.querySelector('.close-dialog')!.addEventListener('click',()=>dialog.close());
</script>
