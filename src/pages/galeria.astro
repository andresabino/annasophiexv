---
import Layout from '../layouts/Layout.astro';
import GuestGalleryView from '../components/GuestGalleryView.astro';
import {siteState} from '../lib/config';
import {approvedGuestPhotos,guestGalleryCanUpload,guestGalleryCanView,guestGallerySettings} from '../lib/guest-gallery';
const state=await siteState(Astro.url);
const settings=await guestGallerySettings();
const canUpload=guestGalleryCanUpload(state.phase,settings.enabled);
const canView=guestGalleryCanView(state.phase);
const photos=canView?await approvedGuestPhotos():[];
---
<Layout {...state} title="Galeria da Festa — Anna Sophie XV">
 <GuestGalleryView phase={state.phase} {canUpload} {canView} {photos}/>
</Layout>
