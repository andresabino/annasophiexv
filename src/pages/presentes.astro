---
import Layout from '../layouts/Layout.astro';
import {siteState} from '../lib/config';
import {getGifts} from '../lib/gifts';
import {pixDetails} from '../lib/pix';
const state=await siteState(Astro.url);
const categories=state.gifts?await getGifts():[];
const pix=state.pix?await pixDetails():null;
const suffix=state.preview?'?previewPhase='+Astro.url.searchParams.get('previewPhase'):'';
---
<Layout {...state} title="Presentes — Anna Sophie XV">{!state.gifts?<section class="page-intro full-height"><p class="eyebrow">COM CARINHO</p><h1>{state.phase==='POST_EVENT'?'Sua presença fez parte da história.':'Sua presença é o nosso maior presente.'}</h1><p>{state.phase==='POST_EVENT'?'Obrigada por cada gesto de carinho. Agora é hora de reviver essa noite.':'As sugestões de presentes serão compartilhadas em breve.'}</p><a class="button burgundy" href={state.phase==='POST_EVENT'?'/fotos':'/'+suffix}>{state.phase==='POST_EVENT'?'Ver fotos':'Voltar ao início'} ↗</a></section>:<>
<section class="page-intro"><p class="eyebrow">ESCOLHIDOS COM CARINHO</p><h1>Sua presença é o<br/><em>nosso maior presente.</em></h1><p>Mas, se desejar nos presentear, reunimos algumas ideias que combinam com a Anna Sophie.</p></section>
<div class="size-strip"><span>Calçados <b>35</b></span><span>Calças <b>36</b></span><span>Camisas / blusas <b>P</b></span></div>
<nav class="category-nav" aria-label="Categorias de presentes">{categories.map(c=><a href={'#'+c.slug}>{c.name}</a>)}</nav>
{categories.map((category,index)=><section class="gift-category" id={category.slug}><header><span>{String(index+1).padStart(2,'0')}</span><h2>{category.name}</h2>{category.size&&<small>Tamanho {category.size}</small>}</header><div class="gift-grid">{category.items.map(gift=><article class="gift-card"><h3>{gift.brand}</h3>{gift.url&&/^https:\/\//.test(gift.url)?<a href={gift.url} target="_blank" rel="noopener noreferrer">VER NA LOJA ↗</a>:<small>Referência da Anna Sophie</small>}</article>)}</div></section>)}
{pix&&<section class="pix-section"><p class="eyebrow">UM CARINHO ESPECIAL</p><h2>Um presente do seu jeito</h2><p>Se preferir, também deixamos uma opção de presente via PIX.</p><button class="button burgundy" id="open-pix">Presentear via PIX ↗</button><dialog id="pix-dialog" aria-labelledby="pix-title"><h2 id="pix-title">Um presente do seu jeito</h2><p>{pix.name}</p><img src={pix.qr} alt="QR Code PIX para presentear" width="256" height="256"/><p class="pix-key">{pix.key}</p><button class="button burgundy" data-copy={pix.key} data-message="Chave PIX copiada.">Copiar chave</button><button class="close-dialog">Fechar</button></dialog></section>}
</>}</Layout>
<script>
const dialog=document.querySelector<HTMLDialogElement>('#pix-dialog');
document.querySelector('#open-pix')?.addEventListener('click',()=>dialog?.showModal());
dialog?.querySelector('.close-dialog')?.addEventListener('click',()=>dialog.close());
</script>
